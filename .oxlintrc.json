{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "oxc", "jest"],
  "categories": { "correctness": "error", "suspicious": "warn", "perf": "warn" },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/.turbo/**", "**/.wrangler/**"],
  "overrides": [{ "files": ["apps/cli/src/**"], "rules": { "no-await-in-loop": "off" } }]
}
